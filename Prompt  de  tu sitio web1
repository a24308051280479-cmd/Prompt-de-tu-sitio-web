    <!-- JAVASCRIPT DE INTERACCIÓN Y VISTA EN TIEMPO REAL -->
    <script>
        let isInspectorActive = false;

        // Selección de Curso al hacer clic en las tarjetas
        function selectCourse(courseTitle, provider) {
            const courseInput = document.getElementById('selectedCourseInput');
            courseInput.value = `${courseTitle} (${provider})`;

            // Desplazamiento suave al formulario
            document.getElementById('registro').scrollIntoView({ behavior: 'smooth' });

            showToast(`Curso seleccionado: "${courseTitle}"`, 'info');
        }

        // Actualizar la vista previa en tiempo real dentro del formulario
        function updateLivePreview() {
            const nameVal = document.getElementById('fullName').value;
            const emailVal = document.getElementById('email').value;
            
            const levelVal = document.querySelector('input[name="escolaridad"]:checked').value;

            document.getElementById('previewName').textContent = nameVal.trim() !== '' ? nameVal : 'Escribe tu nombre...';
            document.getElementById('previewEmail').textContent = emailVal.trim() !== '' ? emailVal : 'Escribe tu correo...';
            document.getElementById('previewLevel').textContent = levelVal;
        }

        // Manejar el envío del formulario
        function handleFormSubmit(e) {
            e.preventDefault();

            const name = document.getElementById('fullName').value;
            const email = document.getElementById('email').value;
            const level = document.querySelector('input[name="escolaridad"]:checked').value;
            const course = document.getElementById('selectedCourseInput').value;

            // Rellenar datos en el modal comprobante
            document.getElementById('modalName').textContent = name;
            document.getElementById('modalEmail').textContent = email;
            document.getElementById('modalLevel').textContent = level;
            document.getElementById('modalCourse').textContent = course;

            // Mostrar el modal
            document.getElementById('registrationModal').classList.remove('hidden');
        }

        // Cerrar modal
        function closeModal() {
            document.getElementById('registrationModal').classList.add('hidden');
            document.getElementById('courseraRegisterForm').reset();
            document.getElementById('selectedCourseInput').value = "Análisis de datos de Google";
            updateLivePreview();
        }

        // Búsqueda interactiva
        function handleSearch() {
            const query = document.getElementById('searchInput').value.trim();
            if (query) {
                showToast(`Buscando resultados para: "${query}"`, 'info');
            }
        }

        // Modo Inspector para estudiante de preparatoria (Resalta las etiquetas HTML)
        function toggleInspectorMode() {
            isInspectorActive = !isInspectorActive;
            const btn = document.getElementById('btnInspector');

            const elements = document.querySelectorAll('[data-tag]');

            if (isInspectorActive) {
                btn.classList.replace('bg-indigo-600', 'bg-emerald-600');
                btn.querySelector('span').textContent = 'Desactivar Inspector HTML';
                
                elements.forEach(el => {
                    el.classList.add('html-highlight');
                    const badge = document.createElement('span');
                    badge.className = 'html-badge';
                    badge.textContent = el.getAttribute('data-tag');
                    el.prepend(badge);
                });

                showToast('Modo Inspector HTML Activado', 'info');
            } else {
                btn.classList.replace('bg-emerald-600', 'bg-indigo-600');
                btn.querySelector('span').textContent = 'Activar Inspector de Etiquetas HTML';
                
                elements.forEach(el => {
                    el.classList.remove('html-highlight');
                    const badge = el.querySelector('.html-badge');
                    if (badge) badge.remove();
                });

                showToast('Modo Inspector Desactivado', 'info');
            }
        }

        // Función para mostrar mensajes flotantes (Toast)
        function showToast(message, type = 'info') {
            const container = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            toast.className = 'pointer-events-auto px-4 py-3 rounded-xl shadow-lg border text-xs font-semibold bg-slate-900 text-white border-slate-700 flex items-center gap-2 transition-all duration-300 transform translate-y-2 opacity-0';
            toast.innerHTML = `<i class="fa-solid fa-circle-info text-coursera-blue"></i> <span>${message}</span>`;
            
            container.appendChild(toast);

            setTimeout(() => {
                toast.classList.remove('translate-y-2', 'opacity-0');
            }, 10);

            setTimeout(() => {
                toast.classList.add('opacity-0', 'translate-y-2');
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }
    </script>


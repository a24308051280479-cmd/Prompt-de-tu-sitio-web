        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        coursera: {
                            blue: '#0056D2',
                            darkBlue: '#003e99',
                            lightBlue: '#e8f0fe',
                            bgGray: '#f5f7fa',
                            textDark: '#1f1f1f',
